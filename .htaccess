# SiteBridge Hub — Apache config for shared hosting (Hostinger hPanel).

# 1) Make sure the Authorization header reaches PHP (some hosts strip it).
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
# CGI/FastCGI variant of the same fix.
<IfModule mod_setenvif.c>
	SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
CGIPassAuth On

# 2) Never serve the config or sample files directly.
<FilesMatch "^(config\.php|config\.sample\.php)$">
	Require all denied
</FilesMatch>

# 3) Route the bare folder to index.php (the MCP endpoint).
DirectoryIndex index.php

# OAuth discovery endpoints must reach PHP.
<IfModule mod_rewrite.c>
    RewriteRule ^\.well-known/oauth-(protected-resource.*|authorization-server)$ index.php [L,QSA]
</IfModule>

# Defense in depth: private runtime and development files are never public.
<FilesMatch "^(connections\.php|.*\.(sqlite|sqlite3|db)(-.*)?|.*\.bak|\.env.*|\.gitignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^(?:tests|wordpress-plugin|\.git)(?:/|$) - [F,L]
</IfModule>
